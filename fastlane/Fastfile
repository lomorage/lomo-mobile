default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # When running fastlane from the root, we need to specify the iOS project path
    build_app(
      workspace: "ios/lomomobile.xcworkspace",
      scheme: "lomomobile"
    )
    upload_to_testflight
  end

  desc "Build Production IPA"
  lane :build_production do
    build_app(
      workspace: "ios/lomomobile.xcworkspace",
      scheme: "lomomobile",
      output_directory: "ios/build",
      output_name: "lomomobile.ipa",
      # Let xcodebuild regenerate Xcode-managed profiles when App ID capabilities change
      xcargs: "-allowProvisioningUpdates"
    )
  end
end

# Release signing credentials are never stored in the repo. They come from LOMO_KEYSTORE_PASSWORD,
# LOMO_KEY_PASSWORD, LOMO_KEY_ALIAS and LOMO_KEYSTORE_PATH, or from an untracked key.properties in
# the repo root (see key.properties.example); environment variables win. If no password is
# configured, no signing properties are passed and the generated android/ project's own signing
# config is used, as before.
def release_signing_properties
  repo_root = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
  props = {}
  key_file = File.join(repo_root, "key.properties")
  if File.exist?(key_file)
    File.foreach(key_file) do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      key, value = line.split("=", 2)
      props[key.strip] = value.to_s.strip if key
    end
  end
  pick = ->(env, key) { ENV[env].to_s.empty? ? props[key].to_s : ENV[env] }

  store_password = pick.call("LOMO_KEYSTORE_PASSWORD", "storePassword")
  if store_password.empty?
    UI.important("No LOMO_KEYSTORE_PASSWORD / key.properties found; using the android/ project's own signing config.")
    return {}
  end
  key_password = pick.call("LOMO_KEY_PASSWORD", "keyPassword")
  key_alias = pick.call("LOMO_KEY_ALIAS", "keyAlias")
  store_file = pick.call("LOMO_KEYSTORE_PATH", "storeFile")
  store_file = "lomo-mobile.jks" if store_file.empty?
  store_file = File.expand_path(store_file, repo_root)
  UI.user_error!("Keystore not found: #{store_file} (set LOMO_KEYSTORE_PATH or storeFile in key.properties)") unless File.exist?(store_file)

  {
    "android.injected.signing.store.file" => store_file,
    "android.injected.signing.store.password" => store_password,
    "android.injected.signing.key.alias" => key_alias.empty? ? "lomo-mobile-key" : key_alias,
    "android.injected.signing.key.password" => key_password.empty? ? store_password : key_password
  }
end

platform :android do
  desc "Build the release AAB"
  lane :build_release do
    # Deliberately no `clean` task here: on this project, Gradle's `clean` triggers a CMake
    # reconfigure/clean that runs before the React Native codegen tasks regenerate their output
    # directories, which breaks the native build (CMake can't find the codegen JNI dirs). If a
    # from-scratch build is ever needed, delete android/app/build, android/app/.cxx, and each
    # node_modules/*/android/build (and .cxx) directory manually, then run this lane.
    gradle(
      task: "bundleRelease",
      project_dir: "android/",
      properties: release_signing_properties,
      # Keep the signing passwords out of fastlane's printed gradle command.
      print_command: false
    )
  end

  desc "Build and upload a new release to the Google Play Console (defaults to the internal track)"
  lane :deploy do |options|
    build_release

    upload_to_play_store(
      track: options[:track] || "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      release_status: options[:release_status] || "draft",
      # A leftover app-release.apk from a local `assembleRelease` makes fastlane refuse to upload
      # ("Cannot provide both apk(s) and aab"); this lane only ever ships the AAB.
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote one version code from the internal track to production at 100% rollout (version_code defaults to android.versionCode in app.json)"
  lane :promote_to_production do |options|
    # Without version_code, Play promotes the internal track's *current* release, which is not
    # necessarily the one just uploaded (a draft upload isn't current): it picked an older build
    # than production's and was refused ("does not allow any existing users to upgrade").
    version_code = options[:version_code]
    if version_code.to_s.empty?
      app_json = File.join(File.expand_path("..", FastlaneCore::FastlaneFolder.path), "app.json")
      version_code = JSON.parse(File.read(app_json)).dig("expo", "android", "versionCode")
    end
    UI.user_error!("No version_code given and none found in app.json") if version_code.to_s.empty?
    UI.message("Promoting version code #{version_code} from internal to production")

    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      track_promote_release_status: "completed",
      version_code: version_code.to_i,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
